# obrigatórios
TELEGRAM_BOT_TOKEN=coloque_aqui_o_token_do_botfather
GROQ_API_KEY=coloque_aqui_sua_chave_groq

# obrigatório — Pesquisador e Guardião rodam no Gemini (cota diária separada do Groq).
# Crie grátis em https://aistudio.google.com/apikey (sem cartão)
GEMINI_API_KEY=coloque_aqui_sua_chave_gemini

# opcional, mas recomendado — sem isso o dossiê não é verificado por busca na web
TAVILY_API_KEY=coloque_aqui_sua_chave_tavily

# só em produção (Render) — deixe em branco/comentado no seu computador para rodar em polling
# WEBHOOK_URL=https://seu-servico.onrender.com

# opcional — ID de um canal/grupo do Telegram onde o bot posta cópia de cada parecer
# (vira seu arquivo permanente, já que o disco do Render free tier é apagado a cada deploy)
# LOG_CHANNEL_ID=-1001234567890

# opcionais de ajuste fino
GROQ_MODEL=llama-3.3-70b-versatile
GEMINI_MODEL=gemini-flash-latest
DOSSIE_MAX_AGE_DAYS=7
MAX_COPY_ATTEMPTS=2

# opcional — só preencha se for usar o servidor local do Telegram pra mandar vídeos
# acima de 20MB (veja README-deploy.md, seção "vídeos grandes"). Pegue essas duas em
# https://my.telegram.org/apps (login com SEU número de telefone, não é o token do bot)
# TELEGRAM_API_ID=123456
# TELEGRAM_API_HASH=coloque_aqui_o_hash

# TELEGRAM_LOCAL_BOT_API=true
# LOCAL_BOT_API_URL=http://localhost:8081
